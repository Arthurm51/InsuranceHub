{
  "name": "OPIN - padrão: 4 apólices de congêneres (Auto, Vida, Previdência, Viagem) para qualquer CPF",
  "priority": 10,
  "request": {
    "method": "GET",
    "urlPath": "/opin/v1/insurance-policies",
    "queryParameters": {
      "cpf": { "matches": "^\\d{11}$" }
    }
  },
